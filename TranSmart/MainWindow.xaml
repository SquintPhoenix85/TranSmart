<Window x:Class="TranSmart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Transit Coverage Optimizer"
        Height="900"
        Width="1440"
        MinHeight="640"
        MinWidth="1000"
        Background="#111827"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI"
        Loaded="MainWindow_OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Northern Corridor Transit Coverage"
                       FontSize="28"
                       FontWeight="Bold" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#AEB8C7"
                       Text="Greedy graph-node placement using walking-network distance; vertices are hypothetical sites, not verified transit stops." />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="18"
                Margin="0,0,0,18"
                Background="#1F2937"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Walking radius" FontWeight="SemiBold" />
                    <TextBlock Text="50–500 m" Foreground="#AEB8C7" FontSize="12" />
                </StackPanel>

                <Slider Grid.Column="1"
                        Minimum="50"
                        Maximum="500"
                        TickFrequency="50"
                        IsSnapToTickEnabled="True"
                        IsEnabled="{Binding CanChangeRadius}"
                        Value="{Binding RadiusMeters, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0" />

                <TextBlock Grid.Column="2"
                           Text="{Binding RadiusMeters, StringFormat={}{0:0} m}"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           MinWidth="76"
                           Margin="0,0,20,0" />

                <Button Grid.Column="3"
                        Content="Run optimization"
                        Command="{Binding RunCommand}"
                        Padding="18,10"
                        FontWeight="SemiBold"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="6" Margin="0,0,0,18">
            <Border Padding="14" Margin="0,0,10,0" Background="#1F2937" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="TOTAL VERTICES" Foreground="#AEB8C7" FontSize="11" />
                    <TextBlock Text="{Binding TotalVertexCount, StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Padding="14" Margin="0,0,10,0" Background="#1F2937" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="SELECTED SITES" Foreground="#AEB8C7" FontSize="11" />
                    <TextBlock Text="{Binding SelectedSiteCount, StringFormat={}{0:N0}}" FontSize="22"
                               FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Padding="14" Margin="0,0,10,0" Background="#1F2937" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="COVERED VERTICES" Foreground="#AEB8C7" FontSize="11" />
                    <TextBlock Text="{Binding CoveredVertexCount, StringFormat={}{0:N0}}" FontSize="22"
                               FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Padding="14" Margin="0,0,10,0" Background="#1F2937" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="COVERAGE" Foreground="#AEB8C7" FontSize="11" />
                    <TextBlock Text="{Binding CoveragePercentage, StringFormat={}{0:0.0}%}" FontSize="22"
                               FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Padding="14" Margin="0,0,10,0" Background="#1F2937" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="NODE REDUCTION" Foreground="#AEB8C7" FontSize="11" />
                    <TextBlock Text="{Binding NodeReductionPercentage, StringFormat={}{0:0.0}%}" FontSize="22"
                               FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Padding="14" Background="#1F2937" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="OPTIMIZATION TIME" Foreground="#AEB8C7" FontSize="11" />
                    <TextBlock Text="{Binding OptimizationTimeMilliseconds, StringFormat={}{0:0.00} ms}" FontSize="22"
                               FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Background="#1F2937" CornerRadius="10" Padding="4">
            <wv2:WebView2 x:Name="CoverageMap" />
        </Border>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="{Binding MapStatusMessage}" Foreground="#93C5FD" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0"
                       Text="Greedy set cover is a heuristic. Coverage represents graph vertices, not people; the road data does not verify pedestrian accessibility."
                       Foreground="#9CA3AF"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>