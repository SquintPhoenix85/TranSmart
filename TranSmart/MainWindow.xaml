<Window x:Class="TranSmart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Cobertura de tránsito · Cobertura voraz de conjuntos"
        Height="900"
        Width="1440"
        MinHeight="700"
        MinWidth="1100"
        Background="{DynamicResource DashboardBackgroundBrush}"
        Foreground="{DynamicResource DashboardForegroundBrush}"
        Loaded="MainWindow_OnLoaded"
        Closed="MainWindow_OnClosed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Estudio de cobertura de redes de transporte público"
                       FontSize="27"
                       FontWeight="Bold" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource DashboardMutedForegroundBrush}"
                       Text="Explora cómo resolver el problema de cobertura de conjuntos mediante métodos heurísticos." />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource DashboardCardStyle}"
                Padding="16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton Content="Optimizar cobertura"
                                 GroupName="MainMode"
                                 IsChecked="{Binding IsCoverageMode, Mode=OneWay}"
                                 Command="{Binding SelectCoverageModeCommand}"
                                 Padding="12,8"
                                 Margin="0,0,12,0"
                                 FontWeight="SemiBold" />
                    <RadioButton Content="Buscar cajeros"
                                 GroupName="MainMode"
                                 IsChecked="{Binding IsAtmMode, Mode=OneWay}"
                                 Command="{Binding SelectAtmModeCommand}"
                                 Padding="12,8"
                                 FontWeight="SemiBold" />
                </StackPanel>

                <Grid Grid.Row="1" Visibility="{Binding IsCoverageMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="Radio de caminata" FontWeight="SemiBold" />
                        <TextBlock Text="Distancia de caminata: 50 - 500 m"
                                   Foreground="{DynamicResource DashboardMutedForegroundBrush}"
                                   FontSize="12" />
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="50" Maximum="500" TickFrequency="50"
                            IsSnapToTickEnabled="True" IsEnabled="{Binding CanChangeRadius}"
                            Value="{Binding RadiusMeters, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock Grid.Column="2" Text="{Binding RadiusMeters, StringFormat={}{0:0} m}"
                               VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"
                               MinWidth="72" Margin="0,0,18,0" />
                    <Button Grid.Column="3" Content="Ejecutar optimización" Command="{Binding RunCommand}"
                            Padding="16,9" FontWeight="SemiBold" />
                </Grid>

                <Grid Grid.Row="1" Visibility="{Binding IsAtmMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding AtmPanelMessage}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,14,0" />
                    <Button Grid.Column="1" Content="Elegir punto en el mapa"
                            Command="{Binding SearchAtmsCommand}" Padding="14,9"
                            FontWeight="SemiBold" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="Actualizar datos OSM"
                            Command="{Binding GenerateGraphCommand}" Padding="14,9"
                            FontWeight="SemiBold" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource DashboardCardStyle}"
                Padding="14"
                Margin="0,0,0,12"
                Visibility="{Binding IsGraphMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Grafo de carreteras no disponible" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Genera amb_graph.json usando datos de OpenStreetMap. Esto requiere Python 3, OSMnx y una conexión a internet estable."
                               Foreground="{DynamicResource DashboardMutedForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Generar grafo"
                        Command="{Binding GenerateGraphCommand}"
                        Padding="16,9"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="3" Columns="8" Margin="0,0,0,14"
                     Visibility="{Binding IsCoverageMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource DashboardCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Nodos de demanda" Foreground="{DynamicResource DashboardMutedForegroundBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalVertexCount, StringFormat={}{0:N0}}" FontSize="21" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Candidatos elegibles" Foreground="{DynamicResource DashboardMutedForegroundBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CandidateSiteCount, StringFormat={}{0:N0}}" FontSize="21" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Sitios elegidos" Foreground="{DynamicResource DashboardMutedForegroundBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedSiteCount, StringFormat={}{0:N0}}" FontSize="21" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Vértices cubiertos" Foreground="{DynamicResource DashboardMutedForegroundBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CoveredVertexCount, StringFormat={}{0:N0}}" FontSize="21" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Cobertura" Foreground="{DynamicResource DashboardMutedForegroundBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CoveragePercentage, StringFormat={}{0:0.0}%}" FontSize="21" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Reducción de candidatos" Foreground="{DynamicResource DashboardMutedForegroundBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NodeReductionPercentage, StringFormat={}{0:0.0}%}" FontSize="21" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Radio resuelto" Foreground="{DynamicResource DashboardMutedForegroundBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SolvedRadiusText}" FontSize="21" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Tiempo de optimización" Foreground="{DynamicResource DashboardMutedForegroundBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding OptimizationTimeMilliseconds, StringFormat={}{0:0.00} ms}" FontSize="21" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding MapTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Padding="3">
                    <wv2:WebView2 x:Name="CoverageMap" />
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Padding="16"
                    Visibility="{Binding IsCoverageMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock Text="Muestra de la toma de decisiones" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding SolvedRadiusText}"
                                   Foreground="{DynamicResource DashboardMutedForegroundBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Grid.Row="1"
                               Margin="0,6,0,12"
                               Text="{Binding ReplayStepSummary}"
                               TextWrapping="Wrap"
                               MinHeight="34" />

                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <DockPanel LastChildFill="False" Margin="0,0,0,5">
                            <TextBlock Text="Cobertura durante la reproducción" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding ReplayCoveragePercentage, StringFormat={}{0:0.0}%}"
                                       Foreground="{DynamicResource DashboardAccentBrush}"
                                       FontWeight="SemiBold" />
                        </DockPanel>
                        <ProgressBar Minimum="0"
                                     Maximum="{Binding TotalVertexCount}"
                                     Value="{Binding ReplayCoveredVertexCount, Mode=OneWay}"
                                     Height="6"
                                     Foreground="{DynamicResource DashboardAccentBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding ReplayCoveredVertexCount, StringFormat={}{0:N0}}" FontSize="12" Foreground="{DynamicResource DashboardMutedForegroundBrush}" />
                            <TextBlock Text=" vértices cubiertos · " FontSize="12" Foreground="{DynamicResource DashboardMutedForegroundBrush}" />
                            <TextBlock Text="{Binding ReplaySelectedSiteCount, StringFormat={}{0:N0}}" FontSize="12" Foreground="{DynamicResource DashboardMutedForegroundBrush}" />
                            <TextBlock Text=" ubicaciones seleccionadas" FontSize="12" Foreground="{DynamicResource DashboardMutedForegroundBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Slider Grid.Row="3"
                            Minimum="0"
                            Maximum="{Binding ReplayStepCount}"
                            Value="{Binding ReplayPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding CanReplay}"
                            SmallChange="1"
                            LargeChange="1"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Margin="0,0,0,8" />

                    <UniformGrid Grid.Row="4" Columns="5" Margin="0,0,0,12">
                        <Button Content="Inicio" Command="{Binding GoToStartCommand}" Margin="0,0,5,0" Padding="5,7" />
                        <Button Content="Anterior" Command="{Binding PreviousStepCommand}" Margin="0,0,5,0" Padding="5,7" />
                        <Button Content="{Binding PlaybackButtonText}" Command="{Binding PlayPauseCommand}" Margin="0,0,5,0" Padding="5,7" />
                        <Button Content="Siguiente" Command="{Binding NextStepCommand}" Margin="0,0,5,0" Padding="5,7" />
                        <Button Content="Final" Command="{Binding GoToEndCommand}" Padding="5,7" />
                    </UniformGrid>

                    <TextBlock Grid.Row="5"
                               Text="Decisiones del algoritmo voraz"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5" />

                    <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Result.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectReplayStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding StepNumber}"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="0"
                                            Margin="0,0,0,6">
                                        <Border Style="{StaticResource DashboardCardStyle}" Padding="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StepNumber}"
                                                           Foreground="{DynamicResource DashboardAccentBrush}"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Ubicación seleccionada" FontSize="11" Foreground="{DynamicResource DashboardMutedForegroundBrush}" />
                                                    <TextBlock Text="{Binding SelectedNodeId, StringFormat={}{0:N0}}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="APORTE" FontSize="10" Foreground="{DynamicResource DashboardMutedForegroundBrush}" HorizontalAlignment="Right" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="+" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Gain}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding CoveredVertexCount, StringFormat={}{0:N0}}"
                                                               Foreground="{DynamicResource DashboardMutedForegroundBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Text=" vértices cubiertos después de esta elección"
                                                               Foreground="{DynamicResource DashboardMutedForegroundBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Padding="16"
                    Visibility="{Binding IsAtmMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Resultados" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding AtmPanelMessage}" TextWrapping="Wrap" Margin="0,8,0,10" />
                    <TextBlock Grid.Row="2" Text="ORDENADOS POR DISTANCIA A PIE"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource DashboardMutedForegroundBrush}"
                               Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NearbyAtms.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding NearbyAtms}"
                             SelectedItem="{Binding SelectedAtm, Mode=TwoWay}"
                             SelectionMode="Single"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
                                                <Setter Property="Padding" Value="10" />
                                                <Setter Property="Margin" Value="0,0,0,8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rank}" Value="1">
                                                        <Setter Property="BorderBrush" Value="#FFFF795C" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FF00C2FF" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Setter Property="Background" Value="#FF233A43" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#FF40334B" CornerRadius="16" Width="28" Height="28"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="5,0,8,0">
                                                <TextBlock Text="{Binding Atm.Name}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="Más cercano al punto seleccionado"
                                                           FontSize="11" Foreground="#FFFFA38F">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rank}" Value="1">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding WalkingDistanceMeters, StringFormat={}{0:0} m}"
                                                       Foreground="{DynamicResource DashboardAccentBrush}"
                                                       FontWeight="Bold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <ProgressBar Height="3"
                         IsIndeterminate="{Binding IsBusy}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Foreground="{DynamicResource DashboardAccentBrush}"
                         Margin="0,0,0,7" />
            <TextBlock Text="{Binding MapStatusMessage}"
                       Foreground="{DynamicResource DashboardMutedForegroundBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFF9B9B" TextWrapping="Wrap" />
            <TextBlock Margin="0,5,0,0"
                       Text="La cobertura voraz de conjuntos es una heurística, no garantiza el mínimo. La cobertura se mide sobre todos los nodos de demanda y la reducción, sobre las ubicaciones candidatas elegibles. Las ubicaciones no están verificadas como paraderos ni como accesos peatonales."
                       Foreground="{DynamicResource DashboardMutedForegroundBrush}"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
